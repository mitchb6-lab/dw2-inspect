<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      A console runner with no test framework: this repo has no NuGet dependencies and gains
      none here. Run it with "dotnet run" and the project option pointing at src\Dw2MpTests;
      exit code 0 means every check passed, 1 names the failures. The same pattern as
      StateDelta.SelfTest in the mod.
    -->
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Dw2MpTests</AssemblyName>
    <RootNamespace>Dw2MpTests</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    The code under test: the shared source the mod and the lobby both compile in, plus the
    lobby's pure join policy and the session types it operates on (no WinForms in either).
  -->
  <ItemGroup>
    <Compile Include="..\Shared\ContentPackCompare.cs" Link="Shared\ContentPackCompare.cs" />
    <Compile Include="..\Shared\SteamAppManifest.cs" Link="Shared\SteamAppManifest.cs" />
    <Compile Include="..\Shared\PeerText.cs" Link="Shared\PeerText.cs" />
    <Compile Include="..\Shared\SyncDigest.cs" Link="Shared\SyncDigest.cs" />
    <Compile Include="..\Shared\KeyframePolicy.cs" Link="Shared\KeyframePolicy.cs" />
    <Compile Include="..\Shared\GalaxyEvents.cs" Link="Shared\GalaxyEvents.cs" />
    <Compile Include="..\Shared\SyncThresholds.cs" Link="Shared\SyncThresholds.cs" />
    <Compile Include="..\Shared\SyncGuards.cs" Link="Shared\SyncGuards.cs" />
    <Compile Include="..\Shared\SessionMemoryBudget.cs" Link="Shared\SessionMemoryBudget.cs" />
    <Compile Include="..\Shared\DiscardedResourceQueue.cs" Link="Shared\DiscardedResourceQueue.cs" />
    <Compile Include="..\Shared\DivergenceReport.cs" Link="Shared\DivergenceReport.cs" />
    <Compile Include="..\Shared\SnapshotHashWriter.cs" Link="Shared\SnapshotHashWriter.cs" />
    <Compile Include="..\Shared\DesyncPolicy.cs" Link="Shared\DesyncPolicy.cs" />
    <Compile Include="..\Dw2MpLobby\Session.cs" Link="Lobby\Session.cs" />
    <Compile Include="..\Dw2MpLobby\JoinPolicy.cs" Link="Lobby\JoinPolicy.cs" />
    <Compile Include="..\Dw2MpLobby\LaunchEnvironment.cs" Link="Lobby\LaunchEnvironment.cs" />
  </ItemGroup>

</Project>
