<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net8.0, NOT net9.0. The game hosts Microsoft.NETCore.App 8.0.0 (see
      DistantWorlds2.Windows.runtimeconfig.json). A net9.0 assembly will not load
      into a net8.0 runtime, and the failure mode is the injection silently doing
      nothing.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Dw2Mp</AssemblyName>
    <RootNamespace>Dw2Mp</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>

    <!-- We are loaded into someone else's process; never drag our own copies in. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DW2_PATH)' != ''">
    <Dw2Dir>$(DW2_PATH)</Dw2Dir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Dw2Dir)' == ''">
    <Dw2Dir>C:\Program Files (x86)\Steam\steamapps\common\Distant Worlds 2</Dw2Dir>
  </PropertyGroup>

  <!--
    Shared SOURCE, not a shared assembly: the mod may carry no DLL the game does not already
    have, and the lobby must not depend on the mod. The content-pack comparison is one file
    compiled into both (and into src\Dw2MpTests, which is where it is tested).
  -->
  <ItemGroup>
    <Compile Include="..\Shared\ContentPackCompare.cs" Link="Shared\ContentPackCompare.cs" />
    <Compile Include="..\Shared\SnapshotHashWriter.cs" Link="Shared\SnapshotHashWriter.cs" />
    <Compile Include="..\Shared\DesyncPolicy.cs" Link="Shared\DesyncPolicy.cs" />
    <Compile Include="..\Shared\PeerText.cs" Link="Shared\PeerText.cs" />
    <Compile Include="..\Shared\SyncDigest.cs" Link="Shared\SyncDigest.cs" />
    <Compile Include="..\Shared\KeyframePolicy.cs" Link="Shared\KeyframePolicy.cs" />
    <Compile Include="..\Shared\GalaxyEvents.cs" Link="Shared\GalaxyEvents.cs" />
    <Compile Include="..\Shared\SyncThresholds.cs" Link="Shared\SyncThresholds.cs" />
    <Compile Include="..\Shared\SyncGuards.cs" Link="Shared\SyncGuards.cs" />
    <Compile Include="..\Shared\SessionMemoryBudget.cs" Link="Shared\SessionMemoryBudget.cs" />
    <Compile Include="..\Shared\DiscardedResourceQueue.cs" Link="Shared\DiscardedResourceQueue.cs" />
    <Compile Include="..\Shared\DiscardedSystemBuffers.cs" Link="Shared\DiscardedSystemBuffers.cs" />
  </ItemGroup>

  <!--
    Private=false / CopyLocal off on every one of these: at runtime the game has
    already loaded them. Shipping our own copies risks binding a second, different
    instance of the same assembly, which is how a Harmony patch silently applies to
    a type nobody is using.
  -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(Dw2Dir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DistantWorlds.Types">
      <HintPath>$(Dw2Dir)\DistantWorlds.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DistantWorlds.Core">
      <HintPath>$(Dw2Dir)\DistantWorlds.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
