<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      net9.0-windows + WinForms: no NuGet, no XAML, nothing to install. The whole point
      of this app is that it can be handed to someone who then runs one file.
    -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Dw2MpLobby</AssemblyName>
    <RootNamespace>Dw2MpLobby</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!--
    Shared SOURCE with the mod (see src\Shared): the content-pack comparison and the Steam
    app-manifest reader. Linked, not referenced, so the lobby still has no dependencies.
  -->
  <ItemGroup>
    <Compile Include="..\Shared\ContentPackCompare.cs" Link="Shared\ContentPackCompare.cs" />
    <Compile Include="..\Shared\SteamAppManifest.cs" Link="Shared\SteamAppManifest.cs" />
    <Compile Include="..\Shared\PeerText.cs" Link="Shared\PeerText.cs" />
  </ItemGroup>

</Project>
